   "source": [
    "import time\n",
    "\n",
    "times = int(input(\"Enter the time\"))\n",
    "\n",
    "for x in range(times, 0, -1):\n",
    "    hours = int(x / 3600)\n",
    "    minutes = int(x / 60) % 60\n",
    "    seconds = x % 60\n",
    "    print(f\"{hours:02}:{minutes:02}:{seconds:02}\")\n",
    "    time.sleep(1)\n",
    "\n",
    "print(\"Times UP!\")"
   ]
  }
 ],
